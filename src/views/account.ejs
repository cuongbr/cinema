<!doctype html>
<html lang="vi">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Vé của tôi | CineVé</title><link rel="stylesheet" href="/assets/styles.css"><link rel="stylesheet" href="/assets/cgv-home.css"></head>
<body class="inner-page cg-inner-page">
  <%- include('partials/inner-header') %>
  <main class="cg-container account-main"><div class="breadcrumb"><a href="/">TRANG CHỦ</a><span>/</span><span>VÉ CỦA TÔI</span></div>
    <div class="account-heading"><div><div class="account-eyebrow">TÀI KHOẢN THÀNH VIÊN</div><h1>VÉ CỦA TÔI</h1><p>Xin chào <strong><%= currentUser.name %></strong> · <%= currentUser.email %></p></div><a class="button button-red" href="/#phim">ĐẶT VÉ MỚI <span aria-hidden="true">→</span></a></div>
    <% if (!bookings.length) { %><div class="account-empty"><span>✦</span><h2>CHƯA CÓ VÉ NÀO</h2><p>Chọn một bộ phim và đặt vé khi đang đăng nhập để xem tại đây.</p><a href="/#phim">Xem phim đang chiếu →</a></div><% } else { %>
      <div class="account-bookings"><% bookings.forEach(booking => { %><article class="account-booking"><div><small>MÃ VÉ #<%= booking.id %> · <%= booking.status === 'paid' ? 'ĐÃ THANH TOÁN MÔ PHỎNG' : 'ĐANG CHỜ' %></small><h2><%= booking.title %></h2><p><%= booking.time %> · Ghế <%= booking.seat_labels || '—' %></p></div><div><strong><%= Number(booking.total_amount).toLocaleString('vi-VN') %> ₫</strong><a href="/bookings/<%= booking.id %>">XEM VÉ →</a></div></article><% }); %></div>
    <% } %>
  </main><footer class="cg-footer"><div class="cg-container cg-inner-footer">CINEVÉ DEMO · LỊCH CHIẾU VÀ THANH TOÁN CHỈ LÀ MÔ PHỎNG</div></footer>
</body></html>
